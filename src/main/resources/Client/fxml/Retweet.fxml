<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="500.0" spacing="12.0" styleClass="retweet-dialog" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.RetweetController">
    <children>
        <Label text="Quote Tweet" styleClass="text-heading" />

        <TextArea fx:id="quoteTextArea" prefRowCount="3" promptText="Add a comment..." styleClass="field-input" wrapText="true" />

        <VBox fx:id="originalTweetContainer" styleClass="retweet-original">
            <children>
                <Label fx:id="originalAuthorLabel" text="&#64;username" styleClass="retweet-original-author" />
                                <Label fx:id="originalTextLabel" text="Original tweet content goes here..." styleClass="retweet-original-text" wrapText="true" />
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="retweet-actions">
            <children>
                <Button onAction="#handleCancel" styleClass="btn-ghost" text="Cancel" />
                <Button onAction="#handleRetweetSubmit" styleClass="btn-primary" text="Retweet" />
            </children>
        </HBox>
    </children>
</VBox>
