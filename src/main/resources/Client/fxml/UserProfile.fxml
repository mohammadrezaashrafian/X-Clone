<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<?import java.lang.String?>
<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="450.0" styleClass="page-surface" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.UserProfileController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="section-title-compact">
            <children>
                <VBox>
                    <children>
                        <Label fx:id="headerNameLabel" text="User Name" styleClass="text-title-lg" />
                        <Label fx:id="tweetCountLabel" text="0 Tweets" styleClass="text-meta" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <styleClass>
                <String fx:value="scroll-pane-transparent" />
                <String fx:value="scroll-pane-no-hbar" />
            </styleClass>
            <content>
                <VBox spacing="15.0">
                    <children>
                        <Pane prefHeight="120.0" styleClass="profile-banner-placeholder" />

                        <HBox alignment="BOTTOM_LEFT" spacing="10.0" styleClass="profile-actions-section">
                            <children>
                                <ImageView fx:id="userAvatarImageView" fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                                    <styleClass>
                                        <String fx:value="profile-avatar-wrapper" />
                                        <String fx:value="profile-avatar-overlap" />
                                    </styleClass>
                                </ImageView>
                                <Pane HBox.hgrow="ALWAYS" />
                                <Button fx:id="followButton" onAction="#handleFollowToggle" styleClass="user-profile-follow-btn" text="Follow" />
                            </children>
                        </HBox>

                        <VBox spacing="8.0" styleClass="profile-info-section">
                            <children>
                                <Label fx:id="displayNameLabel" text="Display Name" styleClass="text-heading" />
                                <Label fx:id="usernameLabel" text="\@username" styleClass="text-meta" />
                                <Label fx:id="bioLabel" text="User bio goes here..." styleClass="text-body" wrapText="true" />

                                <HBox spacing="20.0" styleClass="profile-stats">
                                    <children>
                                        <Label fx:id="followingCountLabel" styleClass="profile-stat-count" text="0 Following" />
                                        <Label fx:id="followersCountLabel" styleClass="profile-stat-count" text="0 Followers" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox fx:id="userTweetsContainer" spacing="10.0" styleClass="tweet-replies-container" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
