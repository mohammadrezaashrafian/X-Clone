<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import java.lang.String?>
<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="450.0" styleClass="page-surface-white" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.UserListController">
    <children>
        <HBox alignment="CENTER_LEFT" styleClass="section-title">
            <children>
                <Label fx:id="pageTitleLabel" text="Followers" styleClass="text-heading" />
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <styleClass>
                <String fx:value="scroll-pane-transparent" />
                <String fx:value="scroll-pane-no-hbar" />
            </styleClass>
            <content>
                <VBox fx:id="usersContainer" spacing="10.0" styleClass="padded" />
            </content>
        </ScrollPane>
    </children>
</VBox>