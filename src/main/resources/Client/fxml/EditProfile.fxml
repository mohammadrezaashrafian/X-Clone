<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Separator?>

<?import java.lang.String?>
<HBox prefWidth="480.0" prefHeight="560.0" alignment="CENTER" styleClass="edit-profile-stage-wrapper" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.EditProfileController">
    <children>
        <VBox prefWidth="468.0" styleClass="edit-profile-clip">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="section-title">
                    <children>
                        <Label text="Edit Profile" styleClass="text-heading" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button fx:id="closeButton" onAction="#handleCancel" styleClass="btn-ghost btn-icon" text="✕" />
                    </children>
                </HBox>

                <Separator styleClass="section-divider" />

                <VBox spacing="15.0" styleClass="edit-profile-content">
                    <children>

                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="edit-profile-avatar-row">
                    <children>
                        <ImageView fx:id="avatarPreview" fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" styleClass="edit-profile-avatar" />
                        <Button fx:id="changeAvatarButton" onAction="#handleChangeAvatar" styleClass="btn-outline" text="Change Photo" />
                    </children>
                </HBox>

                <VBox spacing="5.0" styleClass="form-group">
                    <children>
                        <Label text="Display Name" styleClass="field-label" />
                        <TextField fx:id="displayNameField" promptText="Enter your name" styleClass="field-input" />
                    </children>
                </VBox>

                <VBox spacing="5.0" styleClass="form-group">
                    <children>
                        <Label text="Username" styleClass="field-label" />
                        <TextField fx:id="usernameField" promptText="Enter username" styleClass="field-input" />
                    </children>
                </VBox>

                <VBox spacing="5.0" styleClass="form-group">
                    <children>
                        <Label text="Bio" styleClass="field-label" />
                        <TextArea fx:id="bioTextArea" prefRowCount="3" promptText="Describe yourself..." styleClass="field-input" wrapText="true" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="form-action-row">
                    <children>
                        <Button fx:id="cancelButton" onAction="#handleCancel" text="Cancel" styleClass="btn-ghost btn-secondary" />
                        <Button fx:id="saveButton" onAction="#handleSave" styleClass="btn-primary" text="Save" />
                    </children>
                </HBox>

            </children>
                </VBox>

            </children>
        </VBox>

    </children>
</HBox>