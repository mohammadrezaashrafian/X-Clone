<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<?import java.lang.String?>
<StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="700.0" prefWidth="900.0" styleClass="auth-page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.ResetPasswordController">
    <children>
        <VBox alignment="CENTER"
              maxWidth="420.0"
              spacing="0.0"
              styleClass="auth-card">
            <children>
                <!-- Branding -->
                <VBox alignment="CENTER"
                      spacing="12.0"
                      styleClass="auth-brand">
                    <children>
                        <StackPane alignment="CENTER"
                                   styleClass="auth-logo">
                            <children>
                                <ImageView fx:id="logoImageView"
                                           fitHeight="48.0"
                                           fitWidth="48.0"
                                           pickOnBounds="true"
                                           preserveRatio="true"/>
                            </children>
                        </StackPane>

                        <Label styleClass="auth-title"
                               text="Reset Password">
                            <VBox.margin>
                                <Insets bottom="2.0"/>
                            </VBox.margin>
                        </Label>

                        <Label alignment="CENTER"
                               prefWidth="310.0"
                               text="Enter your new password below."
                               textAlignment="CENTER"
                               styleClass="auth-subtitle"
                               wrapText="true">
                            <VBox.margin>
                                <Insets bottom="8.0"/>
                            </VBox.margin>
                        </Label>

                    </children>
                </VBox>

                <!-- Inputs -->
                <VBox spacing="16.0"
                      styleClass="auth-input-wrapper">
                    <children>
                        <Label text="New Password"
                               styleClass="auth-subtitle"/>

                        <HBox alignment="CENTER_LEFT"
                              prefHeight="52.0"
                              styleClass="auth-input-container">
                            <children>
                                <ImageView                           fitHeight="18.0"
                                           fitWidth="18.0"
                                           preserveRatio="true">
            <styleClass>
                <String fx:value="auth-input-icon"/>
            </styleClass>

                                    <image>
                                        <Image url="@../images/lock.png"/>
                                    </image>

                                </ImageView>

                                <PasswordField fx:id="newPasswordField"
                                               prefHeight="48.0"
                                               promptText="Enter new password"
                                               styleClass="auth-input-field"
                                               HBox.hgrow="ALWAYS"/>

                            </children>
                        </HBox>

                        <Label text="Confirm Password"
                               styleClass="auth-subtitle"/>

                        <HBox alignment="CENTER_LEFT"
                              prefHeight="52.0"
                              styleClass="auth-input-container">
                            <children>
                                <ImageView                           fitHeight="18.0"
                                           fitWidth="18.0"
                                           preserveRatio="true">
            <styleClass>
                <String fx:value="auth-input-icon"/>
            </styleClass>

                                    <image>
                                        <Image url="@../images/lock.png"/>
                                    </image>

                                </ImageView>

                                <PasswordField fx:id="confirmPasswordField"
                                               prefHeight="48.0"
                                               promptText="Confirm new password"
                                               styleClass="auth-input-field"
                                               HBox.hgrow="ALWAYS"/>

                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Error -->
                <VBox fx:id="errorContainer"
                      alignment="CENTER_LEFT"
                      managed="false"
                      visible="false"
                      styleClass="auth-error-banner">
                    <children>
                        <Label fx:id="errorLabel"
                               wrapText="true"
                               styleClass="auth-error-text"/>
                    </children>

                    <VBox.margin>
                        <Insets top="4.0"/>
                    </VBox.margin>

                </VBox>


                <!-- Reset Button -->
                <Button fx:id="resetPasswordButton"
                        maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false"
                        onAction="#handleResetPassword"
                        styleClass="auth-submit-btn"
                        text="Reset Password">

                    <VBox.margin>
                        <Insets top="8.0"/>
                    </VBox.margin>

                </Button>


                <!-- Auth Links -->
                <HBox alignment="CENTER"
                      spacing="24.0"
                      styleClass="auth-links">
                    <children>
                        <Hyperlink fx:id="backToLoginLink"
                                   alignment="CENTER"
                                   onAction="#handleBackToLogin"
                                   styleClass="auth-link"
                                   text="Back to Log in"/>
                    </children>
                </HBox>


                <!-- Footer -->
                <VBox alignment="CENTER"
                      spacing="8.0"
                      styleClass="auth-footer">
                    <children>
                        <HBox alignment="CENTER"
                              spacing="16.0"
                              styleClass="auth-footer-links">
                            <children>

                                <Hyperlink onAction="#handleOpenGitHub"
                                           styleClass="auth-footer-link"
                                           text="GitHub"
                                           disable="true"/>

                                <Label text="|"
                                       styleClass="auth-divider-text"/>

                                <Hyperlink onAction="#handleOpenDocumentation"
                                           styleClass="auth-footer-link"
                                           text="Documentation"
                                           disable="true"/>

                                <Label text="|"
                                       styleClass="auth-divider-text"/>

                                <Label text="Version 2.1.0"
                                       styleClass="auth-footer-version"/>

                            </children>
                        </HBox>
                    </children>

                    <VBox.margin>
                        <Insets top="8.0"/>
                    </VBox.margin>

                </VBox>

            </children>
        </VBox>
    </children>
</StackPane>