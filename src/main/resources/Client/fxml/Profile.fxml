<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import java.lang.String?>

<VBox maxHeight="1.7976931348623157E308"
      maxWidth="1.7976931348623157E308"
      minWidth="450.0"
      styleClass="page-surface"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Client.controllers.ProfileController">

    <children>

        <HBox alignment="CENTER_LEFT"
              spacing="15.0"
              styleClass="section-title-compact">
            <children>
                <VBox>
                    <children>
                        <Label fx:id="headerNameLabel"
                               text="Profile"
                               styleClass="text-title-lg" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true"
                    styleClass="scroll-pane-surface"
                    VBox.vgrow="ALWAYS">

            <content>
                <VBox spacing="15.0"
                      styleClass="timeline-container">

                    <children>

                        <!-- Profile Header Card -->
                        <VBox styleClass="card-surface">
                            <children>

                                <Pane prefHeight="160.0">
                                    <styleClass>
                                        <String fx:value="profile-banner" />
                                        <String fx:value="profile-banner-gradient" />
                                    </styleClass>
                                </Pane>

                                <HBox alignment="BOTTOM_RIGHT"
                                      prefHeight="90.0"
                                      styleClass="profile-actions-section">

                                    <children>

                                        <Pane HBox.hgrow="ALWAYS">
                                            <children>
                                                <ImageView fx:id="profileAvatar"
                                                           fitHeight="100.0"
                                                           fitWidth="100.0"
                                                           layoutY="-50.0"
                                                           pickOnBounds="true"
                                                           preserveRatio="false"
                                                           styleClass="profile-avatar-wrapper">
                                                    <clip>
                                                        <Circle centerX="50.0"
                                                                centerY="50.0"
                                                                radius="50.0" />
                                                    </clip>
                                                </ImageView>
                                            </children>
                                        </Pane>

                                        <Button fx:id="editProfileButton"
                                                onAction="#handleEditProfile"
                                                styleClass="btn-dark"
                                                text="Edit Profile" />

                                    </children>
                                </HBox>

                                <VBox spacing="8.0"
                                      styleClass="profile-info-section">

                                    <children>

                                        <Label fx:id="displayNameLabel"
                                               text="Name"
                                               styleClass="text-title-xl" />

                                        <Label fx:id="usernameLabel"
                                               text="&#64;username"
                                               styleClass="text-meta" />

                                        <Label fx:id="bioLabel"
                                               text="User bio goes here..."
                                               styleClass="text-body"
                                               wrapText="true">

                                            <VBox.margin>
                                                <Insets bottom="5.0"
                                                        top="5.0" />
                                            </VBox.margin>

                                        </Label>

                                        <HBox spacing="20.0"
                                              styleClass="profile-stats">

                                            <children>

                                                <HBox onMouseClicked="#handleShowFollowing"
                                                      spacing="5.0"
                                                      styleClass="profile-stat-item">
                                                    <children>
                                                        <Label fx:id="followingCountLabel"
                                                               styleClass="profile-stat-count"
                                                               text="0" />

                                                        <Label text="Following"
                                                               styleClass="profile-stat-label" />
                                                    </children>
                                                </HBox>

                                                <HBox onMouseClicked="#handleShowFollowers"
                                                      spacing="5.0"
                                                      styleClass="profile-stat-item">
                                                    <children>
                                                        <Label fx:id="followersCountLabel"
                                                               styleClass="profile-stat-count"
                                                               text="0" />

                                                        <Label text="Followers"
                                                               styleClass="profile-stat-label" />
                                                    </children>
                                                </HBox>

                                            </children>
                                        </HBox>

                                    </children>
                                </VBox>

                            </children>
                        </VBox>

                        <!-- User Posts Card -->
                        <VBox styleClass="card-surface">
                            <styleClass>
                                <String fx:value="card-surface" />
                                <String fx:value="padded" />
                            </styleClass>

                            <children>

                                <Label maxWidth="1.7976931348623157E308"
                                       styleClass="profile-tweets-header"
                                       text="Posts" />

                                <VBox fx:id="userTweetsContainer"
                                      spacing="10.0"
                                      styleClass="profile-tweets-container">

                                    <children>
                                        <Label text="You haven't posted anything yet."
                                               styleClass="text-meta" />
                                    </children>

                                </VBox>

                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>

        </ScrollPane>

    </children>
</VBox>