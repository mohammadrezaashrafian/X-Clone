<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<HBox fx:id="rootContainer" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="12.0" styleClass="user-list-item" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.UserItemController">
    <children>
        <ImageView fx:id="avatarImageView" fitHeight="44.0" fitWidth="44.0" pickOnBounds="true" preserveRatio="true">
            <clip>
                <Circle centerX="22.0" centerY="22.0" radius="22.0" />
            </clip>
        </ImageView>

        <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="displayNameLabel" text="Display Name" styleClass="text-body-bold" />
                <Label fx:id="usernameLabel" text="&#64;username" styleClass="text-meta" />
            </children>
        </VBox>

        <VBox alignment="CENTER_RIGHT" spacing="8.0">
            <children>
                <Button fx:id="messageButton" styleClass="btn-outline" text="Message" />
                <Button fx:id="followButton" styleClass="btn-primary" text="Follow" />
            </children>
        </VBox>
    </children>
</HBox>
