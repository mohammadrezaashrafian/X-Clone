<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<?import java.lang.String?>
<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="450.0" styleClass="page-surface" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.TimelineController">
    <children>

        <HBox alignment="CENTER_LEFT" styleClass="section-title">
            <children>
                <Label text="Home" />
            </children>
        </HBox>

        <VBox spacing="15.0" styleClass="tweet-composer">
            <children>
                <HBox alignment="TOP_LEFT" spacing="15.0">
                    <children>
                        <ImageView fx:id="currentUserAvatar" fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true" styleClass="tweet-composer-avatar" />
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <TextField fx:id="newTweetField" promptText="What's happening?!" styleClass="tweet-composer-input" />

                                <ImageView fx:id="mediaPreview" fitHeight="150.0" fitWidth="250.0" preserveRatio="true" visible="false" managed="false" styleClass="tweet-composer-media" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>

                        <Button fx:id="addMediaButton" onAction="#handleSelectMedia" styleClass="link-text" text="📷 Media" />

                        <Button fx:id="addPollButton" onAction="#handleCreatePoll" styleClass="link-text" text="📊 Poll" />

                        <Pane HBox.hgrow="ALWAYS" />

                        <Button fx:id="submitTweetButton" onAction="#handleSubmitTweet" styleClass="btn-primary-sm" text="Post" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <styleClass>
                <String fx:value="scroll-pane-surface" />
                <String fx:value="scroll-pane-no-hbar" />
            </styleClass>
            <content>
                <VBox fx:id="tweetsContainer" spacing="12.0" styleClass="timeline-container">
                    <children>
                        <Label text="No posts yet! Your timeline is empty." styleClass="empty-state" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>

    </children>
</VBox>