<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="500.0" spacing="15.0" styleClass="image-upload-dialog" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.ImageUploadDialogController">
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label text="Attach Images" styleClass="text-heading" />
            </children>
        </HBox>

        <Button onAction="#handleChooseImages" styleClass="btn-outline" text="Choose Images..." />

        <ScrollPane fitToHeight="true" prefHeight="140.0" styleClass="image-upload-preview-scroll" VBox.vgrow="ALWAYS">
            <content>
                <HBox fx:id="imagePreviewContainer" alignment="CENTER_LEFT" spacing="10.0" styleClass="image-upload-preview-container" />
            </content>
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="image-upload-actions">
            <children>
                <Button onAction="#handleCancel" styleClass="btn-ghost" text="Cancel" />
                <Button onAction="#handleConfirm" styleClass="btn-primary" text="Done" />
            </children>
        </HBox>
    </children>
</VBox>
