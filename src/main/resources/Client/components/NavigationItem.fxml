<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<!--
  Reusable sidebar navigation item.
  The host controller configures the icon, label and action (see
  NavigationItemController.configure) and drives the active state.
-->
<Button fx:id="navButton"
        maxWidth="1.7976931348623157E308"
        mnemonicParsing="false"
        styleClass="nav-item"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="Client.controllers.NavigationItemController">

    <graphic>
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <children>
                <Label fx:id="navIcon" styleClass="nav-item-icon" text="•"/>
                <Label fx:id="navLabel" styleClass="nav-item-label" text="Item"/>
            </children>
        </HBox>
    </graphic>

</Button>
