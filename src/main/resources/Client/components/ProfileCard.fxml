<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!--
  Reusable current-user card for the sidebar.
  Loads its own profile data and navigates through the NavigationManager.
-->
<HBox fx:id="profileCard"
      alignment="CENTER_LEFT"
      maxWidth="1.7976931348623157E308"
      spacing="10.0"
      styleClass="sidebar-user-section"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Client.controllers.ProfileCardController">
    <children>

        <ImageView fx:id="profileAvatar"
                   fitHeight="40.0"
                   fitWidth="40.0"
                   pickOnBounds="true"
                   preserveRatio="true"
                   styleClass="sidebar-user-avatar">
            <clip>
                <Circle centerX="20.0" centerY="20.0" radius="20.0"/>
            </clip>
        </ImageView>

        <VBox alignment="CENTER_LEFT"
              spacing="1.0"
              HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="profileName"
                       maxWidth="1.7976931348623157E308"
                       styleClass="sidebar-user-name"
                       text="Loading"/>
                <Label fx:id="profileHandle"
                       maxWidth="1.7976931348623157E308"
                       styleClass="sidebar-user-handle"
                       text="\@..."/>
            </children>
        </VBox>

        <Button fx:id="profileActionButton"
                mnemonicParsing="false"
                styleClass="sidebar-user-action"
                text="⋮"/>

    </children>
</HBox>
